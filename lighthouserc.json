{
  "_comment": "Lighthouse CI config. PRD §8.4 / Sprint 11 (Mobile Polish & Accessibility) targets: Performance ≥90, Accessibility ≥95, Best Practices ≥95, SEO ≥90. Sprint 1c sets up the config; full runs happen in CI once a deploy preview exists.",
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4002/",
        "http://localhost:4002/candidate/login",
        "http://localhost:4002/backoffice/login",
        "http://localhost:4002/examcenter/login"
      ],
      "startServerCommand": "MIX_ENV=test mix phx.server",
      "startServerReadyPattern": "Access GuildfordVueWeb.Endpoint at",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
