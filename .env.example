# .env.example — copy to .env and fill in. Never commit .env.
#
# Loaded by config/runtime.exs at boot via System.fetch_env!/1. In dev,
# Phoenix reads sensible defaults so most of these can stay unset locally
# unless you're hitting a real external service.

# ----------------------------------------------------------------------------
# Phoenix
# ----------------------------------------------------------------------------
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=replace_me_with_mix_phx_gen_secret_output
PHX_HOST=localhost
PORT=4000

# ----------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# Default points at the local docker-compose `db` service.
# ----------------------------------------------------------------------------
DATABASE_URL=ecto://postgres:postgres@localhost:5434/guildford_vue_dev
POOL_SIZE=10

# ----------------------------------------------------------------------------
# Email (Swoosh)
# Dev: Mailcatcher on localhost:1025 (no auth)
# Prod: Mailgun
# ----------------------------------------------------------------------------
SMTP_RELAY=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_FROM=no-reply@guildfordvue.test

# ----------------------------------------------------------------------------
# S3 / Tigris / MinIO — PDF receipt storage
# Default points at local minio.
# ----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=guildford-vue-pdfs

# ----------------------------------------------------------------------------
# Error reporting (Sentry) — dev unset is fine.
# ----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# ----------------------------------------------------------------------------
# BEAM distribution (only set in clustered prod).
# ----------------------------------------------------------------------------
RELEASE_COOKIE=
RELEASE_NODE=

# ----------------------------------------------------------------------------
# Geocoding (OS Names API). Optional in dev — we ship with seeded coords.
# ----------------------------------------------------------------------------
OS_NAMES_API_KEY=

# ----------------------------------------------------------------------------
# Fly deploy (CI only)
# ----------------------------------------------------------------------------
FLY_API_TOKEN=
