# Files secret-scan.sh should never flag.
# One path-glob per line, regex syntax (extended).
#
# Use sparingly — the default should be to fix the leak, not suppress it.

^\.env\.example$
^config/dev\.exs$
^config/test\.exs$
^docs/.*\.md$
^docs/sprint-reports/.*
^test/e2e/.*\.spec\.ts$
^_tmp-design/.*
^cover/.*
^_build/.*
^deps/.*
^node_modules/.*
^assets/node_modules/.*
^\.elixir_ls/.*
^scripts/secret-scan\.sh$
^\.gitleaks.*
^\.secretsignore$
